{
  "name": "hamacar-angular",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "format": "prettier --write src docs tools README.md package.json angular.json tsconfig*.json",
    "format:check": "prettier --check src docs tools README.md package.json angular.json tsconfig*.json",
    "check:architecture": "node tools/check-architecture.mjs",
    "prebuild": "node tools/write-config.mjs",
    "prestart": "node tools/write-config.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@supabase/supabase-js": "^2.117.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "jsdom": "^27.0.0",
    "node": "24.15.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
